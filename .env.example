# PostgreSQL
UDR_DB_HOST=localhost
UDR_DB_PORT=5432
UDR_DB_DATABASE=dns_threat_detection
UDR_DB_USERNAME=postgres
UDR_DB_PASSWORD=your_password_here

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dns_threat_detection
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection Pool
UDR_DB_MIN_CONNECTIONS=2
UDR_DB_MAX_CONNECTIONS=10
UDR_DB_CONNECT_TIMEOUT=10
UDR_DB_COMMAND_TIMEOUT=30
UDR_DB_MAX_IDLE_TIME=300

# Authentication & Sessions
# Generate secrets with: openssl rand -hex 32
DNSNETRA_ENV=development
AUTH_SESSION_SECRET=
AUTH_CAPTCHA_SECRET=
AUTH_SESSION_EXPIRE_MINUTES=480
AUTH_CAPTCHA_EXPIRE_SECONDS=300
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_SIGNUP=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=
