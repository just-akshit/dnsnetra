# Runtime data artifacts
# Datasets and binary intelligence databases are regenerable and large, so they
# stay out of the public repository. Rebuild them with:
#   .venv/bin/python scripts/data/generate_historical_dataset.py
data/intelligence/*.db
data/datasets/*.csv
data/samples/logs/*.log
data/samples/logs/*.log.bak

