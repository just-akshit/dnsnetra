# ===========================================================================
# PostgreSQL Databases Configuration (MVP 4-DB Architecture)
# ===========================================================================

# Default / Primary Database (Telemetry, Profiling, Auth)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dns_threat_detection
DB_USER=postgres
DB_PASSWORD=your_password

# 1. Trusted Threat Intelligence Database
TRUSTED_DB_HOST=localhost
TRUSTED_DB_PORT=5432
TRUSTED_DB_DATABASE=trusted_db
TRUSTED_DB_USERNAME=postgres
TRUSTED_DB_PASSWORD=your_password

# 2. Malicious Threat Intelligence Database
MALICIOUS_DB_HOST=localhost
MALICIOUS_DB_PORT=5432
MALICIOUS_DB_DATABASE=malicious_db
MALICIOUS_DB_USERNAME=postgres
MALICIOUS_DB_PASSWORD=your_password

# 3. Reputation Cache Database
REPUTATION_DB_HOST=localhost
REPUTATION_DB_PORT=5432
REPUTATION_DB_DATABASE=reputation_db
REPUTATION_DB_USERNAME=postgres
REPUTATION_DB_PASSWORD=your_password

# 4. Daily Review / Unknown Domain Database
DAILY_REVIEW_DB_HOST=localhost
DAILY_REVIEW_DB_PORT=5432
DAILY_REVIEW_DB_DATABASE=daily_review_db
DAILY_REVIEW_DB_USERNAME=postgres
DAILY_REVIEW_DB_PASSWORD=your_password

# Incremental Dashboard Aggregation
AGGREGATION_BATCH_SIZE=10000
AGGREGATION_NAME=dashboard
RECENT_FLAGGED_DOMAINS_LIMIT=100
AGGREGATION_STALE_THRESHOLD_MINUTES=60
